EXPO_PUBLIC_APP_MODE=demo
# Set mode to supabase to enable real authentication and backend persistence.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Native: folivio://auth/callback. Web: your HTTPS origin + /auth/callback.
EXPO_PUBLIC_AUTH_REDIRECT_URL=folivio://auth/callback
# A UI availability flag only. Supabase must also have Phone Auth + SMS configured.
EXPO_PUBLIC_SMS_CONFIGURED=false
# Backend private.settings must separately enable KYC before uploads are accepted.
EXPO_PUBLIC_KYC_CONFIGURED=false
# Enable after deploying paper-order. Logs failed simulated orders in the admin dashboard.
EXPO_PUBLIC_PAPER_API_CONFIGURED=false
